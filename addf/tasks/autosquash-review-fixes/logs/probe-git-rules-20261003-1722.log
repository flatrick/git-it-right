git version 2.56.0

=== subject rule (r2)
%s of 'feat: one\n  two  \nthree\n\nbody': 'feat: one   two three\n'

## wrapped fixup subject vs older 'feat: one three'
%s before: ['feat: one three', 'fixup! feat: one two']
%s after:  ['feat: one three', 'fixup! feat: one two']
RESULT: LEFT

## wrapped target title, fixup names the joined subject
%s before: ['feat: one two', 'fixup! feat: one two']
%s after:  ['feat: one two']
RESULT: folded

## two spaces after the prefix
%s before: ['feat: one', 'fixup!  feat: one']
%s after:  ['feat: one']
RESULT: folded

## tab after the prefix
%s before: ['feat: one', 'fixup!\tfeat: one']
%s after:  ['feat: one', 'fixup!\tfeat: one']
RESULT: LEFT

## prefix chain with two spaces inside
%s before: ['feat: one', 'fixup!  squash!  feat: one']
%s after:  ['feat: one']
RESULT: folded

## wrapped amend! subject, no message paragraph
%s before: ['feat: one', 'amend! feat: one']
%s after:  ['']
RESULT: folded

=== merge commit as a target (r3)
before: ['feat: side', 'feat: main', "Merge branch 'side'", "fixup! Merge branch 'side'"]
after:  ['feat: main', 'feat: side', "fixup! Merge branch 'side'"]

=== HEAD during `git rebase <upstream> <branch>` from another checkout (r5)
after: ['feat: a', 'feat: b', 'fixup! HEAD~2']
files: ['feat:', 'a:', 'a', 'feat:', 'b:', 'b', 'fixup!', 'HEAD~2:', 'c']

